# Backend API URL (e.g., http://localhost:3000)
# Leave empty to proxy through Vite in development
VITE_API_URL=

# Ollama configuration
# In dev, Vite proxies /ollama -> http://127.0.0.1:11434
# In prod, server.js proxies /ollama -> http://127.0.0.1:11434
VITE_OLLAMA_BASE_URL=/ollama
VITE_OLLAMA_MODEL=llama3.2
VITE_EMBEDDING_MODEL=nomic-embed-text
